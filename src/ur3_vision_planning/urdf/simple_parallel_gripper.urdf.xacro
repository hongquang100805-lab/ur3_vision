<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="simple_parallel_gripper" params="name parent">
    <link name="${name}_base_link">
      <visual>
        <origin xyz="0 0 0.025"/>
        <geometry><box size="0.07 0.11 0.05"/></geometry>
        <material name="gripper_frame"><color rgba="0.22 0.28 0.30 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.025"/>
        <geometry><box size="0.07 0.11 0.05"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.025"/>
        <mass value="0.25"/>
        <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/>
      </inertial>
    </link>
    <joint name="${name}_base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${name}_left_finger_link">
      <visual>
        <origin xyz="0 0 0.05"/>
        <geometry><box size="0.014 0.012 0.10"/></geometry>
        <material name="gripper_finger"><color rgba="0.12 0.55 0.48 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.05"/>
        <geometry><box size="0.014 0.012 0.10"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.05"/>
        <mass value="0.04"/>
        <inertia ixx="0.00004" ixy="0" ixz="0" iyy="0.00004" iyz="0" izz="0.000001"/>
      </inertial>
    </link>
    <joint name="${name}_left_finger_joint" type="prismatic">
      <parent link="${name}_base_link"/>
      <child link="${name}_left_finger_link"/>
      <origin xyz="0 -0.05 0.05" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0" upper="0.043" effort="20" velocity="0.04"/>
      <!-- Avoid simulator stiction at the prismatic limit; contact friction is
           provided on the finger links below. -->
      <dynamics damping="0.01" friction="0.0"/>
    </joint>

    <link name="${name}_right_finger_link">
      <visual>
        <origin xyz="0 0 0.05"/>
        <geometry><box size="0.014 0.012 0.10"/></geometry>
        <material name="gripper_finger"><color rgba="0.12 0.55 0.48 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.05"/>
        <geometry><box size="0.014 0.012 0.10"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.05"/>
        <mass value="0.04"/>
        <inertia ixx="0.00004" ixy="0" ixz="0" iyy="0.00004" iyz="0" izz="0.000001"/>
      </inertial>
    </link>
    <joint name="${name}_right_finger_joint" type="prismatic">
      <parent link="${name}_base_link"/>
      <child link="${name}_right_finger_link"/>
      <!-- Both simulator joints use a positive parent-frame axis. The right
           joint is open at q=0.043 and closes by decreasing to q=0. -->
      <origin xyz="0 0.007 0.05" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0" upper="0.043" effort="20" velocity="0.04"/>
      <dynamics damping="0.01" friction="0.0"/>
    </joint>

    <gazebo reference="${name}_left_finger_link">
      <mu1>2.0</mu1>
      <mu2>2.0</mu2>
    </gazebo>
    <gazebo reference="${name}_right_finger_link">
      <mu1>2.0</mu1>
      <mu2>2.0</mu2>
    </gazebo>

    <ros2_control name="${name}" type="system">
      <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
      <joint name="${name}_left_finger_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"><param name="initial_value">0</param></state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${name}_right_finger_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"><param name="initial_value">0.043</param></state_interface>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>
  </xacro:macro>
</robot>
