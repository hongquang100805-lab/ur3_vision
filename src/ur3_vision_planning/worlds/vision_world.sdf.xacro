<?xml version="1.0"?>
<sdf version="1.9" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="camera_config" default="$(find ur3_vision_planning)/config/camera.yaml"/>
  <xacro:property name="cam" value="${xacro.load_yaml('$(arg camera_config)')['camera']}"/>
  <!-- Keep world name 'empty': existing working grasp services use it. -->
  <world name="empty">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>${cam['render_engine']}</render_engine>
    </plugin>
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.1 0.1 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="${cam['model_name']}">
      <static>true</static>
      <pose>${' '.join(str(v) for v in cam['position'] + cam['rpy'])}</pose>
      <link name="${cam['link_frame']}">
        <sensor name="overhead_rgbd" type="${cam['sensor_type']}">
          <always_on>true</always_on>
          <update_rate>${cam['update_rate']}</update_rate>
          <visualize>true</visualize>
          <topic>${cam['gz_topic']}</topic>
          <gz_frame_id>${cam['optical_frame']}</gz_frame_id>
          <camera>
            <horizontal_fov>${cam['horizontal_fov']}</horizontal_fov>
            <image><width>${cam['width']}</width><height>${cam['height']}</height><format>R8G8B8</format></image>
            <clip><near>${cam['near_clip']}</near><far>${cam['far_clip']}</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
